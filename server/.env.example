# Socrates API environment template.
# Copy to .env, fill the required values, and keep real secrets out of git.
# Generated from the process.env names read by server/src (114 total).

# ── Core server ──
# Required for this feature; set a real value.
APP_URL=
CORS_ALLOWED_HOSTS=
# Required for this feature; set a real value.
DATABASE_URL=
LOG_LEVEL=
NODE_ENV=
PORT=
# Required for this feature; set a real value.
SESSION_SECRET=

# ── Built-in provider (Beagle) ──
BEAGLE_IS_REASONING=
# Required for this feature; set a real value.
BEAGLE_SYSTEM_KEY=
BEAGLE_SYSTEM_URL=

# ── Chat and context ──
CHAT_CONTEXT_KEEP_TURNS=
CHAT_CONTEXT_MAX_TOKENS=
# Soft spend-control threshold (0 disables early compression; hard model limit remains).
CHAT_CONTEXT_SOFT_TOKENS=24000
# Defer expensive native schemas until needed (0 restores full core tool list).
CHAT_DEFER_CORE_TOOLS=1
# Model-only previews of oversized tool results; 0 restores legacy output.
CHAT_TOOL_RESULT_COMPACT=1
CHAT_TOOL_RESULT_PREVIEW_TOKENS=2500
CHAT_TOOL_RESULT_METRICS=0
# Only documented provider-specific cache hints; 0 disables affinity fields.
CHAT_PROVIDER_CACHE_HINTS=1
CHAT_OPENROUTER_CLAUDE_CACHE=1
CHAT_LENGTH_CONTINUE_MAX=
CHAT_RAG_TIMEOUT_MS=
CHAT_RAG_VECTOR_TIMEOUT_MS=

# ── Workspace agent (Pi/Codex) ──
CODEX_TURN_TIMEOUT_MS=
CODEX_WORKSPACE_MAX_DISK_MB=
CODEX_WORKSPACE_MAX_MEMORY_MB=
CODEX_WORKSPACE_ROOT=
PI_AGENT_ALLOW_NET=
PI_AGENT_BIN=
PI_AGENT_BWRAP_BIN=
PI_AGENT_ENABLED=
PI_AGENT_ENV_ALLOWLIST=
PI_AGENT_ISOLATION=
PI_AGENT_MODEL=
PI_AGENT_PROVIDER=
PI_AGENT_THINKING=
PI_AGENT_TIMEOUT_MS=
PI_AGENT_TMPFS_BYTES=
PI_AGENT_TURN_TIMEOUT_MS=

# ── Content extraction and Python sandbox ──
ALLOW_DEV_EVAL=
CONTENT_EXTRACT_POOL_SIZE=
CONTENT_EXTRACT_TIMEOUT_MS=

# ── Connectors and integrations ──
CONNECTOR_FEISHU_APP_ID=
CONNECTOR_FEISHU_APP_SECRET=
CONNECTOR_FEISHU_CALLBACK_URL=
CONNECTOR_GITEE_CALLBACK_URL=
CONNECTOR_GITEE_CLIENT_ID=
CONNECTOR_GITEE_CLIENT_SECRET=
CONNECTOR_GITHUB_APP_ID=
CONNECTOR_GITHUB_APP_SLUG=
CONNECTOR_GITHUB_CALLBACK_URL=
CONNECTOR_GITHUB_CLIENT_ID=
CONNECTOR_GITHUB_CLIENT_SECRET=
CONNECTOR_GITHUB_PRIVATE_KEY_PATH=
CONNECTOR_GITHUB_WEBHOOK_SECRET=
CONNECTOR_NOTION_CALLBACK_URL=
CONNECTOR_NOTION_CLIENT_ID=
CONNECTOR_NOTION_CLIENT_SECRET=
CONNECTOR_STATE_SECRET=
# Required for this feature; set a real value.
OOMOL_PROJECT_API_KEY=
OOMOL_PROJECT_CONNECTOR_BASE_URL=

# ── Email and notifications ──
SMTP_USER=

# ── Admin and limits ──
ADMIN_IP_ALLOWLIST=
ADMIN_PASSWORD=
AUDIT_RETENTION_DAYS=

# ── Observability (OpenTelemetry) ──
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# ── Android and mobile ──
ANDROID_APP_LINKS_PACKAGE_NAME=
ANDROID_APP_LINKS_SHA256_FINGERPRINTS=

# ── Other ──
EMBEDDING_DISABLED=
EXEC_CJK_FONT_DIR=
EXEC_CJK_FONT_TIMEOUT_MS=
EXEC_MAX_ARTIFACT_BYTES=
EXEC_MAX_CODE_CHARS=
EXEC_MAX_OUTPUT_BYTES=
EXEC_PYODIDE_VERSION=
# Writable directory for Pyodide's downloaded wheels. The default is
# /var/lib/socrates/pyodide-packages in production and a temp directory in dev.
EXEC_PYODIDE_PACKAGE_CACHE_DIR=
EXEC_RETENTION_DAYS=
EXEC_RUNNER=
EXEC_SCRATCH_DIR=
# Log executions at or above this wall time with a phase breakdown (default 5000 ms).
EXEC_SLOW_LOG_MS=
EXEC_SCRATCH_TTL_DAYS=
EXEC_TIMEOUT_MS_DEFAULT=
# Time a request can wait for a session lock and a ready worker (default 30000 ms).
EXEC_WORKER_WAIT_TIMEOUT_MS=
# Time a worker can spend booting (default 45000 ms).
EXEC_WORKER_BOOT_TIMEOUT_MS=
EXEC_WORKER_POOL_SIZE=
FILES_USER_QUOTA_BYTES=
GITHUB_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HTTP_PROXY=
HTTPS_PROXY=
IMAGE_MODEL=
INTERNAL_METRICS_TOKEN=
LLM_DEFAULT_MAX_TOKENS=
LLM_PROXY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=
MINIMAX_SEARCH_BASE_URL=
MINIMAX_SEARCH_KEY=
OAUTH_PUBLIC_ORIGIN=
OC_CLOUD_PROVIDER_CONFIG_IDS=
REQUEST_TIMEOUT_MS=
SCHEDULER_ENABLED=
SCHEDULER_POLL_MS=
SEARXNG_BASE_URL=
SOCRATES_ALLOW_DEV_SECRET=
SOCRATES_FETCHD_PATH=
SOCRATES_RUST_EXTRACT=
SOCRATES_RUST_FETCH=
STATUS_EVENTS_RETENTION_DAYS=
STATUS_UNCONFIRMED_RETENTION_DAYS=
STATUS_URL=
TOOL_MAX_CONCURRENCY=
TTS_RETENTION_DAYS=
UPLOAD_DIR=
URL_CACHE_MAX_BYTES=
USAGE_RETENTION_DAYS=
WEB_SEARCH_HOST=
WEB_SEARCH_QUERY_EXPANSION=
WORKSPACE_MAX_DISK_MB=
WORKSPACE_MAX_MEMORY_MB=
WORKSPACE_ROOT=

# ── Security and limits ──
SESSION_COMPRESS_DISABLE=
