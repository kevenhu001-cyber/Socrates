{
  "name": "socrates-api",
  "version": "0.1.0",
  "private": true,
  "description": "Socrates AI tutor — backend API server",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "lint": "find src/ -name '*.js' -exec node --check {} \\;",
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.40.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.0",
    "pdf-parse": "^1.1.1",
    "pyodide": "^0.26.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "drizzle-kit": "^0.30.0"
  },
  "engines": {
    "node": ">=20"
  }
}
