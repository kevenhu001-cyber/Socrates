{
  "name": "socrates-api",
  "version": "0.1.0",
  "private": true,
  "description": "Socrates AI tutor — backend API server",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "lint": "find src/ -name '*.js' -exec node --check {} \\;",
    "test": "node --test --test-force-exit test/*.test.js test/*.test.mjs",
    "test:strict": "node --test test/*.test.js test/*.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@oomol-lab/connector": "^1.0.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "epub": "^2.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pyodide": "^0.26.4",
    "rtf2text": "^1.0.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "drizzle-kit": "^0.31.10"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
