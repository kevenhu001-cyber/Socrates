{
  "name": "socrates-api",
  "version": "0.1.0",
  "private": true,
  "description": "Socrates AI tutor — backend API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.runtime.ts",
    "start": "node src/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.js",
    "lint": "npm run typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:strict": "node scripts/run-tests.mjs --strict"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@oomol-lab/connector": "^1.0.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "epub": "^2.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pyodide": "^0.26.4",
    "rtf2text": "^1.0.1",
    "undici": "^7.28.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
