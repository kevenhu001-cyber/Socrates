{
  "name": "socrates-api",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild": true
  },
  "description": "Socrates AI tutor — backend API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.runtime.ts",
    "start": "node src/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.js",
    "lint": "npm run typecheck && npm run lint:boundaries",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx scripts/run-tests.mjs",
    "test:unit": "node --import tsx --import ./scripts/test-env.mjs --test test/*.test.js test/*.test.mjs",
    "test:strict": "node --import tsx scripts/run-tests.mjs --strict",
    "test:coverage": "node --import tsx --import ./scripts/test-env.mjs --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='**/*.generated.ts' test/*.test.js test/*.test.mjs",
    "lint:boundaries": "node scripts/check-service-boundaries.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@oomol-lab/connector": "^1.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@openuidev/lang-core": "1.0.1",
    "@socrates/core": "file:../packages/core",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "epub": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "pyodide": "^0.26.4",
    "rtf2text": "^1.0.1",
    "undici": "^7.30.1",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "volta": {
    "node": "22.23.1"
  }
}
