{
  "name": "socrates-api",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "@openuidev/lang-core": true,
    "esbuild": true,
    "protobufjs": true
  },
  "description": "Socrates AI tutor — backend API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.runtime.ts",
    "worker": "tsx src/worker.runtime.ts",
    "start": "node src/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:verify-ledger": "node scripts/check-migration-ledger.mjs",
    "db:seed": "tsx src/db/seed.js",
    "lint": "npm run typecheck && npm run lint:boundaries && npm run lint:empty-catch",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx scripts/run-tests.mjs",
    "test:fast": "node ../scripts/run-affected-tests.mjs",
    "test:unit": "node --import tsx --import ./scripts/test-env.mjs --test test/*.test.js test/*.test.mjs",
    "test:strict": "node --import tsx scripts/run-tests.mjs --strict",
    "test:db:memory": "node scripts/run-memory-tests.mjs",
    "test:coverage": "node --import tsx --import ./scripts/test-env.mjs --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='**/*.generated.ts' test/*.test.js test/*.test.mjs",
    "lint:boundaries": "node scripts/check-service-boundaries.mjs",
    "lint:empty-catch": "node ../scripts/check-empty-catch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@oomol-lab/connector": "^1.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@openuidev/lang-core": "1.1.1",
    "@socrates/contracts": "file:../packages/contracts",
    "@socrates/core": "file:../packages/core",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "epub": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsdom": "^31.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "pyodide": "^0.26.4",
    "rtf2text": "^1.0.1",
    "undici": "^7.30.1",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@hono/node-server": "^2.1.3",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.11",
    "ip-address": "^10.7.4",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "volta": {
    "node": "22.23.1"
  }
}
