{
  "name": "socrates-capacitor",
  "private": true,
  "version": "1.0.0",
  "description": "Capacitor Android shell for the shared Socrates frontend",
  "scripts": {
    "web:build": "npm --prefix ../frontend run build",
    "sync": "npm run web:build && npx cap sync android",
    "apk:debug": "node scripts/apk.mjs debug prod",
    "apk:debug:staging": "node scripts/apk.mjs debug staging",
    "apk:debug:local": "node scripts/apk.mjs debug local",
    "apk:release": "node scripts/apk.mjs release prod",
    "apk:release:staging": "node scripts/apk.mjs release staging"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/clipboard": "^7.0.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.1",
    "@capawesome/capacitor-file-picker": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.8.3"
  }
}
