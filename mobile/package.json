{
  "name": "socrates-mobile",
  "version": "2.0.1",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "detox test -c android.debug",
    "check:parity": "node scripts/check-parity-manifest.mjs",
    "check:theme": "node scripts/check-theme-drift.mjs",
    "verify:apk": "node scripts/verify-apk.mjs",
    "visual:build": "EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787/api/v2 expo export --platform web --output-dir dist-visual",
    "visual:capture": "node scripts/visual/capture.mjs",
    "visual:all": "npm run visual:build && npm run visual:capture"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/noto-sans-sc": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.3.15",
    "@socrates/contracts": "file:../packages/contracts",
    "@socrates/core": "file:../packages/core",
    "@socrates/theme": "file:../packages/theme",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "highlight.js": "^11.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "detox": "^20.51.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
