{
  "expo": {
    "name": "Socrates",
    "slug": "socrates-mobile",
    "version": "2.0.1",
    "icon": "../assets/buildResources/icon_android_1024.png",
    "orientation": "portrait",
    "scheme": "socrates",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.topodrive.socrates",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "../assets/buildResources/icon_android_foreground_1024.png",
        "backgroundColor": "#2D2D32"
      }
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withDetoxE2E",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Socrates to use your microphone for voice input.",
          "speechRecognitionPermission": "Allow Socrates to convert your voice into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-document-picker",
      "expo-image-picker",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "../assets/buildResources/icon_1024.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "apiBaseUrl": "https://app.topodrive.top/api/v2"
    }
  }
}
