      },
      {
        "id": "zeta",
        "label": "Damping ratio",
        "value": 0.3,
        "min": 0.1,
        "max": 2
      }
    ],
    "definitions": {
      "realDen": "1-(x/wn)^2",
      "imagDen": "2*zeta*x/wn",
      "magnitude": "-20*log10(hypot(realDen,imagDen))",
      "phase": "-atan2(imagDen,realDen)*180/pi"
    },
