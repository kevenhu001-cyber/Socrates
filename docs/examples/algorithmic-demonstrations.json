{
  "grating": {
    "version": 1,
    "parameters": [
      {
        "id": "N",
        "label": "缝数 N",
        "value": 6,
        "min": 2,
        "max": 12,
        "step": 1
      },
      {
        "id": "ratio",
        "label": "d / a",
        "value": 4,
        "min": 1,
        "max": 8,
        "step": 0.1
      },
      {
        "id": "wavelength",
        "label": "波长",
        "value": 550,
        "min": 380,
        "max": 750,
        "step": 5,
        "unit": "nm"
      },
      {
        "id": "gamma",
        "label": "显示伽马",
        "value": 0.4,
        "min": 0.2,
        "max": 1,
        "step": 0.05,
        "advanced": true
      }
    ],
    "definitions": {
      "phase": "pi*x*550/wavelength",
      "envelope": "sinc(phase/ratio)^2",
      "intensity": "envelope*sinratio(N,phase)^2"
    },
    "views": [
      {
        "kind": "controls"
      },
      {
        "kind": "plot",
        "x": [
          -3.3,
          3.3
        ],
        "y": [
          0,
          1.08
        ],
        "xLabel": "d · sinθ / 550 nm",
        "yLabel": "I / I₀",
        "curves": [
          {
            "expression": "intensity",
            "label": "总光强",
            "color": "blue"
          },
          {
            "expression": "envelope",
            "label": "单缝包络",
            "color": "muted",
            "dashed": true
          }
        ]
      },
      {
        "kind": "field",
        "x": [
          -3.3,
          3.3
        ],
        "y": [
          -1,
          1
        ],
        "expression": "intensity",
        "gamma": "gamma",
        "tint": [
          0.55,
          1,
          0.08
        ],
        "height": 64
      },
      {
        "kind": "metrics",
        "values": [
          {
            "label": "主峰间距（归一化）",
            "expression": "wavelength/550",
            "digits": 2
          },
          {
            "label": "单缝第一暗纹（归一化）",
            "expression": "ratio*wavelength/550",
            "digits": 2
          }
        ]
      }
    ]
  },
  "airy": {
