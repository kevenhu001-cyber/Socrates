{
  "oscillator": {
    "version": 1,
    "parameters": [
      {
        "id": "mass",
        "label": "质量 m",
        "value": 1,
        "min": 0.5,
        "max": 3,
        "step": 0.1,
        "unit": "kg"
      },
      {
        "id": "stiffness",
        "label": "劲度 k",
        "value": 4,
        "min": 1,
        "max": 9,
        "step": 0.5,
        "unit": "N/m"
      }
    ],
    "definitions": {
      "force": "-stiffness*q",
      "energy": "mass*v^2/2+stiffness*q^2/2"
    },
    "dynamics": {
      "initial": {
        "q": 1,
        "v": 0
      },
      "derivatives": {
        "q": "v",
        "v": "force/mass"
      },
      "duration": 10,
      "step": 0.01
    },
    "views": [
      {
        "kind": "scene",
        "label": "弹簧振子与回复力",
        "x": [
          -2,
          2
        ],
        "y": [
          -1,
          1
        ],
        "xLabel": "x (m)",
        "yLabel": "y (m)",
        "objects": [
          {
            "kind": "rod",
            "from": [
              -1.8,
              -0.4
            ],
            "to": [
              -1.8,
              0.4
            ],
            "color": "muted"
          },
          {
            "kind": "spring",
            "from": [
              -1.8,
              0
            ],
            "to": [
              "q-0.2",
              0
            ],
            "color": "blue"
          },
          {
            "kind": "block",
            "center": [
              "q",
              0
            ],
            "width": 0.4,
            "height": 0.4,
            "color": "blue",
            "label": "m"
          },
          {
            "kind": "vector",
            "from": [
              "q",
              0.4
            ],
            "to": [
              "q+force/5",
              0.4
            ],
            "color": "red",
            "label": "F (1 m = 5 N)"
          }
        ]
      },
      {
        "kind": "controls"
      },
      {
        "kind": "plot",
        "label": "位移随时间变化",
        "x": [
          0,
          10
        ],
        "y": [
          -1.2,
          1.2
        ],
        "xLabel": "t (s)",
        "yLabel": "q (m)",
        "curves": [
          {
            "expression": "cos(sqrt(stiffness/mass)*x)",
            "color": "blue",
            "label": "q(t)"
          }
        ],
        "markers": [
          {
            "x": "t",
            "y": "q",
            "color": "red"
          }
        ]
      },
      {
        "kind": "metrics",
        "values": [
          {
            "label": "位移",
            "expression": "q",
            "unit": "m"
          },
          {
            "label": "回复力",
            "expression": "force",
            "unit": "N"
          },
          {
            "label": "机械能",
            "expression": "energy",
            "unit": "J"
          }
        ]
      }
    ]
  },
