{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* No baseUrl: TypeScript 6 deprecates it and 7 removes it. Without it,
       the relative `paths` below resolve against this file directly. */
    "paths": {
      "@socrates/contracts": ["../contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
