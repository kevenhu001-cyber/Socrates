import { writeFileSync, readFileSync } from 'node:fs';
import { library } from '../src/react/intelligence-ui/openui/library';

// Model signatures come from the exact component library. No React enters the server.
const spec = library.toSpec();
const signatures = [...Object.values(spec.components), ...Object.values(spec.functions ?? {})].map((item) => item.signature).join('\n');
const groupNotes = (spec.componentGroups ?? []).flatMap((group) => group.notes ?? []).join("\n");
const prompt = `OpenUI Lang 1.0 is declarative, not JavaScript. Use it for working calculators, forms, charts, study cards and diagrams. An openui node has {id, type:"openui", source:<program>}.\nWrite root first, then referenced statements. One assignment per line. Declare mutable state as $count = 5. Bind an input's first argument to $count; other components read it. Expressions support arithmetic, comparisons, ternary, string concatenation and @functions. References are bare identifiers. Arrays/objects use JSON syntax. null skips an optional positional argument. Repeat with @Each(list, "item", expression); use item.field or list[index] to read data. Built-ins include @Count(list), @Sum(list), @Avg(list), @Round(number, decimals), @Filter(list, "field", "==", value). Use condition ? a : b, not @If. Chain actions with Action([@Set($count, 1), @ToAssistant("Continue")]). No JavaScript, imports, functions or handlers.\nFor a pocket calculator use root = Col([Calculator("Calculator")]); it already implements arithmetic and input handling. For every tool, plan input -> state -> action/derived value -> displayed result before emitting UI. Every input must feed displayed content or an explicit Form submission. Every action must affect a visible result or submitted field; never create unused state or hardcoded result placeholders. Deterministic calculations, filtering, sorting, list edits and resets run locally; never replace them with a chat request. Every enabled Button needs an explicit action. Use @ToAssistant only for intentional chat requests. Declare all $state variables. Bind every input to $state and derive displayed results from that state; do not hardcode results. Guard division by zero. Use render_intelligent_ui for every reader-facing visual, whether static or interactive. For a static chart or diagram, a single Visualization(template, title, payload, accessibilitySummary) component is enough; compose it with controls bound to the same $state when interaction helps. The payload is the template inner data, for example {"categories":["A"],"series":[{"name":"n","data":[1]}]}, never a versioned visualization envelope, and payload expressions may read $state. Do not use a separate visualization tool call or legacy viz fence.\n${groupNotes}\nExample:\nroot = Col([Card([Title("Study planner"), hours, result])])\n$hours = 2\nhours = Slider($hours, 1, 8, 1, "Hours per day")\nresult = Text("Weekly hours: " + ($hours * 7))\nActions: @Set($count, $count + 1), @Reset($count), @ToAssistant("Help me with my answers"), @OpenUrl("https://example.com"). Form([fields, Button("Continue", @ToAssistant("Help me choose"))]) submits field values to chat. Local changes update immediately without model calls. No Query/Mutation or network tools are exposed inside OpenUI.\nLayout gap/padding count 4px steps. Colors: ink, muted, faint, surface, info, success, warning, danger, purple, pink, chart1 through chart6. Use Grid minChildWidth for responsive columns. Keep essential conclusions in prose. All visible labels use the user's language. Use SearchImage(query) for real photographs; the server finds images and renders attribution. For maps, prefer MapMarker(label, null, null, category, null, "landmark, city, country") so the server resolves coordinates. Never guess coordinates or image URLs. Map(markers, true, $selected) adds a driving route overview, not walking directions. No Query/Mutation is needed for Map or SearchImage. Never invent factual data.\nAvailable positional signatures (exact argument order):\n${signatures}`;
const output = `// Generated by frontend/scripts/generate-openui-prompt.mts. Do not hand-edit.\nexport const OPENUI_TOOL_GUIDANCE = ${JSON.stringify(prompt)};\nexport const OPENUI_SCHEMA = ${JSON.stringify(library.toJSONSchema())};\n`;
const target = new URL('../../server/src/services/openUiPrompt.generated.ts', import.meta.url);
if (process.argv.includes('--check')) {
  if (readFileSync(target, 'utf8') !== output) throw new Error('OpenUI tool prompt drift; run npm run generate:openui');
} else writeFileSync(target, output);
