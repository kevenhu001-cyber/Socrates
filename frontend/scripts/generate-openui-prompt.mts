import { writeFileSync, readFileSync } from 'node:fs';
import { library } from '../src/react/intelligence-ui/openui/library';

// Model signatures come from the exact component library. No React enters the server.
const spec = library.toSpec();
const signatures = [...Object.values(spec.components), ...Object.values(spec.functions ?? {})].map((item) => item.signature).join('\n');
const prompt = `OpenUI Lang 1.0 is declarative, not JavaScript. Use it for working calculators, forms, charts, study cards and diagrams. An openui node has {id, type:"openui", source:<program>}.\nWrite root first, then referenced statements. One assignment per line. Declare mutable state as $count = 5. Bind an input's first argument to $count; other components read it. Expressions support arithmetic, comparisons, ternary, string concatenation and @functions. References are bare identifiers. Arrays/objects use JSON syntax. null skips an optional positional argument. Repeat with @Each(list, "item", expression); use item.field or list[index] to read data. Built-ins include @Count(list), @Sum(list), @Avg(list), @Round(number, decimals), @Filter(list, "field", "==", value). Use condition ? a : b, not @If. Chain actions with Action([@Set($count, 1), @ToAssistant("Continue")]). No JavaScript, imports, functions or handlers.\nExample:\nroot = Col([Card([Title("Study planner"), hours, result])])\n$hours = 2\nhours = Slider($hours, 1, 8, 1, "Hours per day")\nresult = Text("Weekly hours: " + ($hours * 7))\nActions: @Set($count, $count + 1), @Reset($count), @ToAssistant("Help me with my answers"), @OpenUrl("https://example.com"). Form([fields, Button("Continue", @ToAssistant("Help me choose"))]) submits field values to chat. Local changes update immediately without model calls. No Query/Mutation or network tools are exposed inside OpenUI.\nLayout gap/padding count 4px steps. Colors: ink, muted, faint, surface, info, success, warning, danger, purple, pink, chart1 through chart6. Use Grid minChildWidth for responsive columns. Keep essential conclusions in prose. All visible labels use the user's language. Use SearchImage(query) for real photographs; the server finds images and renders attribution. For maps, prefer MapMarker(label, null, null, category, null, "landmark, city, country") so the server resolves coordinates. Never guess coordinates or image URLs. Map(markers, true, $selected) adds a driving route overview, not walking directions. No Query/Mutation is needed for Map or SearchImage. Never invent factual data.\nAvailable positional signatures (exact argument order):\n${signatures}`;
const output = `// Generated by frontend/scripts/generate-openui-prompt.mts. Do not hand-edit.\nexport const OPENUI_TOOL_GUIDANCE = ${JSON.stringify(prompt)};\n`;
const target = new URL('../../server/src/services/openUiPrompt.generated.ts', import.meta.url);
if (process.argv.includes('--check')) {
  if (readFileSync(target, 'utf8') !== output) throw new Error('OpenUI tool prompt drift; run npm run generate:openui');
} else writeFileSync(target, output);
