; frontend/package-lock.json pins 130 tarballs to https://registry.npmmirror.com.
; npm >= 12 defaults to allow-remote=none and refuses those URLs.
allow-remote=all
; npm 11 refuses project-scoped installs when ~/.npmrc restrictively
; allowlists postinstall scripts. Native build steps (esbuild's postinstall,
; rollup's binary fetch, etc.) need to run for `npm ci` to produce a
; working Vite build; without this the deploy aborts on EALLOWSCRIPTS.
allow-scripts=true