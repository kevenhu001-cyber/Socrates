{
  "name": "socrates-app",
  "private": true,
  "version": "1.0.0",
  "allowScripts": {
    "esbuild": true
  },
  "type": "module",
  "description": "Socrates — single-page learning app (Vite-bundled)",
  "scripts": {
    "sync:site-fonts": "node scripts/sync-site-fonts.mjs",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "audit:entry": "node scripts/entry-graph.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "lint": "tsc --noEmit && node ../scripts/check-explicit-any.mjs && eslint src && node scripts/check-react-globals.mjs && node scripts/check-react-roots.mjs && node scripts/check-css-debt.mjs && node scripts/check-button-sizes.mjs && node scripts/check-z-index.mjs && node scripts/check-empty-catch.mjs && node scripts/check-composer-css.mjs && node scripts/check-surface-ownership.mjs && node scripts/check-surface-ladder.mjs && node scripts/check-focus-ring.mjs && node scripts/check-font-weight.mjs && node scripts/check-cjk-punctuation-fonts.mjs && node scripts/check-mobile-css.mjs && node scripts/check-i18n-locales.mjs && node scripts/check-e2e-artifacts.mjs && node scripts/check-chat-layering.mjs && node scripts/check-prompt-dashes.mjs && node scripts/check-external-hosts.mjs && node scripts/check-legacy-js.mjs && node scripts/check-state-ownership.mjs && node scripts/check-button-primitive.mjs && node ../scripts/gen-csp-hashes.mjs && node ../scripts/check-packages-dom.mjs && node ../scripts/check-doc-paths.mjs && node ../scripts/check-forwarding-shims.mjs && node scripts/check-shadcn-adoption.mjs",
    "lint:explicit-any": "node ../scripts/check-explicit-any.mjs",
    "lint:eslint": "eslint src",
    "lint:css-debt": "node scripts/check-css-debt.mjs",
    "lint:button-sizes": "node scripts/check-button-sizes.mjs",
    "lint:z-index": "node scripts/check-z-index.mjs",
    "lint:empty-catch": "node scripts/check-empty-catch.mjs",
    "lint:composer-css": "node scripts/check-composer-css.mjs",
    "lint:surface-css": "node scripts/check-surface-ownership.mjs",
    "lint:surface-ladder": "node scripts/check-surface-ladder.mjs",
    "lint:focus-ring": "node scripts/check-focus-ring.mjs",
    "lint:font-weight": "node scripts/check-font-weight.mjs",
    "lint:cjk-punctuation-fonts": "node scripts/check-cjk-punctuation-fonts.mjs",
    "lint:mobile-css": "node scripts/check-mobile-css.mjs",
    "lint:react-globals": "node scripts/check-react-globals.mjs",
    "lint:react-roots": "node scripts/check-react-roots.mjs",
    "lint:i18n-locales": "node scripts/check-i18n-locales.mjs",
    "lint:e2e-artifacts": "node scripts/check-e2e-artifacts.mjs",
    "lint:chat-layering": "node scripts/check-chat-layering.mjs",
    "lint:prompt-dashes": "node scripts/check-prompt-dashes.mjs",
    "lint:csp-hashes": "node ../scripts/gen-csp-hashes.mjs",
    "parity:audit": "node scripts/parity-audit.mjs",
    "parity:check": "node scripts/parity-audit.mjs --check",
    "parity:update": "node scripts/parity-audit.mjs --update",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test test/*.test.mjs",
    "test:coverage": "tsx --tsconfig tsconfig.test.json --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='src/vendor-files/**' --test-coverage-exclude='e2e/**' test/*.test.mjs",
    "test:smoke": "playwright test --config=playwright.config.mjs",
    "test:smoke:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "test:smoke:headed": "playwright test --config=playwright.config.mjs --headed",
    "test:smoke:ui": "playwright test --config=playwright.config.mjs --ui",
    "debug:shoot": "node debug/shoot.mjs",
    "debug:probe": "node debug/probe.mjs",
    "debug:interactive": "node debug/interactive.mjs",
    "lint:packages-dom": "node ../scripts/check-packages-dom.mjs",
    "test:universal": "node scripts/run-universal-smoke.mjs",
    "lint:external-hosts": "node scripts/check-external-hosts.mjs",
    "lint:legacy-js": "node scripts/check-legacy-js.mjs",
    "lint:state-ownership": "node scripts/check-state-ownership.mjs",
    "lint:button-primitive": "node scripts/check-button-primitive.mjs",
    "lint:docs": "node ../scripts/check-doc-paths.mjs",
    "lint:shims": "node ../scripts/check-forwarding-shims.mjs",
    "generate:openui": "tsx scripts/generate-openui-prompt.mts",
    "lint:shadcn": "node scripts/check-shadcn-adoption.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "3.23.2",
    "globals": "^17.13.0",
    "javascript-obfuscator": "^5.9.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.101.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@socrates/contracts": "file:../packages/contracts",
    "@socrates/core": "file:../packages/core",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tldraw/assets": "5.5.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.62.0",
    "maplibre-gl": "6.16.0",
    "marked": "^13.0.3",
    "misans": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tldraw": "5.5.2",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "@vercel/blob": {
      "undici": "^6.29.1"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
