{
  "name": "socrates-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Socrates — single-page learning app (Vite-bundled)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test test/*.test.mjs",
    "test:smoke": "playwright test --config=playwright.config.mjs",
    "test:smoke:headed": "playwright test --config=playwright.config.mjs --headed",
    "test:smoke:ui": "playwright test --config=playwright.config.mjs --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.8",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-task-item": "^3.29.1",
    "@tiptap/extension-task-list": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "dompurify": "3.2.4",
    "echarts": "^6.1.0",
    "mermaid": "^11.16.0",
    "plotly.js-dist-min": "^3.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tldraw": "^5.2.5"
  }
}
