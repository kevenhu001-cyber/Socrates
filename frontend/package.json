{
  "name": "socrates-app",
  "private": true,
  "version": "1.0.0",
  "allowScripts": {
    "esbuild": true
  },
  "type": "module",
  "description": "Socrates \u2014 single-page learning app (Vite-bundled)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "lint": "tsc --noEmit && eslint src && node scripts/check-react-globals.mjs && node scripts/check-css-debt.mjs && node scripts/check-empty-catch.mjs && node scripts/check-composer-css.mjs && node scripts/check-surface-ownership.mjs && node scripts/check-mobile-css.mjs && node scripts/check-i18n-locales.mjs && node scripts/check-e2e-artifacts.mjs && node scripts/check-chat-layering.mjs && node ../scripts/gen-csp-hashes.mjs && node ../scripts/check-packages-dom.mjs && node ../scripts/check-packages-dom.mjs",
    "lint:eslint": "eslint src",
    "lint:css-debt": "node scripts/check-css-debt.mjs",
    "lint:empty-catch": "node scripts/check-empty-catch.mjs",
    "lint:composer-css": "node scripts/check-composer-css.mjs",
    "lint:surface-css": "node scripts/check-surface-ownership.mjs",
    "lint:mobile-css": "node scripts/check-mobile-css.mjs",
    "lint:react-globals": "node scripts/check-react-globals.mjs",
    "lint:i18n-locales": "node scripts/check-i18n-locales.mjs",
    "lint:e2e-artifacts": "node scripts/check-e2e-artifacts.mjs",
    "lint:chat-layering": "node scripts/check-chat-layering.mjs",
    "lint:csp-hashes": "node ../scripts/gen-csp-hashes.mjs",
    "parity:audit": "node scripts/parity-audit.mjs",
    "parity:check": "node scripts/parity-audit.mjs --check",
    "parity:update": "node scripts/parity-audit.mjs --update",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test test/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='src/vendor-files/**' --test-coverage-exclude='e2e/**' test/*.test.mjs",
    "test:smoke": "playwright test --config=playwright.config.mjs",
    "test:smoke:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "test:smoke:headed": "playwright test --config=playwright.config.mjs --headed",
    "test:smoke:ui": "playwright test --config=playwright.config.mjs --ui",
    "debug:shoot": "node debug/shoot.mjs",
    "debug:probe": "node debug/probe.mjs",
    "debug:interactive": "node debug/interactive.mjs",
    "lint:packages-dom": "node ../scripts/check-packages-dom.mjs",
    "test:universal": "node scripts/run-universal-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "3.23.2",
    "globals": "^17.13.0",
    "javascript-obfuscator": "^5.9.0",
    "jsdom": "^29.1.1",
    "terser": "^5.51.2",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@socrates/contracts": "file:../packages/contracts",
    "@socrates/core": "file:../packages/core",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dompurify": "^3.4.12",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "marked": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tldraw": "^5.5.2",
    "zustand": "^5.0.15"
  }
}
