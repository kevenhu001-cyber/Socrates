{
  "name": "socrates-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Socrates — single-page learning app (Vite-bundled)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test test/*.test.mjs",
    "test:smoke": "playwright test --config=playwright.config.mjs",
    "test:smoke:headed": "playwright test --config=playwright.config.mjs --headed",
    "test:smoke:ui": "playwright test --config=playwright.config.mjs --ui",
    "debug:shoot": "node debug/shoot.mjs",
    "debug:probe": "node debug/probe.mjs",
    "debug:interactive": "node debug/interactive.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "3.23.2",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@socrates/contracts": "file:../packages/contracts",
    "@socrates/core": "file:../packages/core",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-task-item": "^3.29.1",
    "@tiptap/extension-task-list": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "marked": "^13.0.3",
    "mermaid": "^11.16.0",
    "plotly.js-dist-min": "^3.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tldraw": "^5.2.5",
    "zustand": "^5.0.8"
  }
}
