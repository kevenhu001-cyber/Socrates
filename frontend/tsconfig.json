{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@socrates/contracts": ["../packages/contracts/src/index.ts"],
      "@socrates/core": ["../packages/core/src/index.ts"],
      "@socrates/core/*": ["../packages/core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../packages/core/src/**/*.ts", "../packages/contracts/src/**/*.ts"],
  "exclude": ["../packages/core/src/**/*.test.ts", "../packages/contracts/src/**/*.test.ts"]
}
