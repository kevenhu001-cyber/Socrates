# ── Web project ──
node_modules/
.env
*.env.local
*.env.*
!server/.env.example
server/secrets/
*.pem
server.log
server/dist/
server/dist.previous/
server/.dist-next.*/
server/dist.failed.*/

# ── Android / Gradle ──
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/signing.properties
*.iml
.idea/
*.hprof
# APKs are distribution artifacts, not source. The Android client is published
# as a GitHub Release asset (tag android-v<version>) and site/download.html
# links there; a 38 MB debug APK was committed once in dbff47e0 and every clone
# still carries it. Never add another one.
*.apk

# ── OS files ──
.DS_Store
Thumbs.db

# ── Playwright MCP artifacts ──
.playwright-mcp/
test-results/

# ── OpenCode / IDE ──
.omo/
.opencode/
.zcode/
.kiro/
.agents/
.codex/
.claude/
apply_patch_example.txt
*.tmp.cjs

# ── Screenshot / audit scratch dirs (playwright QA runs) ──
.shots/
.shots-*/
shots-tmp/
audit-shots/
audit_shots/
tmp-shots/
frontend/tmp-shots/
*.shots/
shots*.cjs
audit_shots.cjs
query_args.json
%TEMP%/
socr-shots/
socr-shots-*/

# ── Firecrawl CLI cache ──
.firecrawl/

# ── Local tooling artifacts ──
.codegraph/
codegraph.db
openai-codex-*.tgz
codex/
tools-rust/target/
.vite/
server.log.bak.*

# ── Kilo Code (local IDE extension) ──
.kilo/

# ── Deploy state (written by deploy.sh on successful deploys) ──
.deploy-state.json
.deploy-state.site.json

# ── Local runtime state (scratch DB, project id) ──
.freebuff/

# ── Temp / debug / scratch files ──
check_tmp.mjs
commit_message.json
Claude-Opus-4.7.txt
server/_test_*.mjs
server/_repro_*.mjs
server/test_browser.mjs
server/_test_date.mjs
graphify-out/
graphify-out-*/
debug.log
# esbuild/Playwright transform + node compile cache; swept into 3f195e49 by an
# over-broad `git add`. Regenerable, and the cache key embeds the Node version.
frontend/.tmp-esbuild/

# ── Root-level probe files named "-", "%TEMP%", "*.tgz" etc. left by tooling ──
# ("nul" is a Windows device name; tools that redirect to it under git-bash
# create a real file that git cannot index.)
/-
/-*/
nul
# ── E2E diagnostic / scratch artifacts ──
# One-off probes that surface during playwright debugging. Note that the
# legitimate shared helpers _lib.mjs and _mock-api.mjs are intentionally
# NOT matched by these patterns (they are imported by other specs).
frontend/e2e/_diag*.mjs
frontend/e2e/_inspect.mjs
frontend/e2e/zz-*.mjs
frontend/e2e/tmp-*.mjs
frontend/e2e/probe-*.mjs
frontend/e2e/__probe*
frontend/probe-*.mjs

# ── Agent / IDE tool output committed by mistake (2026-09-25 review) ──
# AGENTS.md already says "do not commit generated dist/, test reports,
# secrets, or deployment state", but commit ca0bbd54 ("build(ui): 完成生产
# 环境构建并生成资源文件", 42 files / +2,914 lines) brought ~440 KB of raw
# build, typecheck, unit-test and Playwright logs into the tree along with a
# scratch probe directory. These are regenerable tool output: ignore the
# patterns so the class cannot come back, not just the instances.
.qoder-*
.vite-dev.log
*.tmp-repro/
frontend/.tmp-repro/
# Regenerable build output dumped at the repo root (commit 5ddb172b).
/build.log

# Stray debug screenshots at the repo root. README screenshots live under
# docs/assets/ and are whitelisted below; anything captured at the root is a
# one-off and does not belong in the tree.
/form-label-issue.png
/debug-*.png
/repro-*.png
frontend/verify-cdn.mjs
frontend/index.html.bak

# ── UI mockup screenshots (not needed in version control) ──
*.png
!site/media/*.png
!assets/buildResources/icon_android_1024.png
!assets/buildResources/icon_android_foreground_1024.png
!frontend/src/assets/connector-icons/*.png
!frontend/public/logo.png
!frontend/e2e/composer-tools-visual-baseline.spec.mjs-snapshots/*.png
!/docs/assets/parity-2026-10-19/*.png
!docs/design/assets/**/*.png

# ── Local Playwright debug probe scripts/artifacts ──
frontend/debug/
# One-off capture/inspect scripts belong in frontend/scripts/ (or nowhere).
# Root-level shot*/shoot*/dbg*/tmp* files are scratch work, not project tooling.
/frontend/shot*.mjs
/frontend/shoot*.mjs
/frontend/dbg*.mjs
/frontend/tmp-*.mjs
/frontend/.tmp-*.mjs

# ── Large planning docs (not needed in version control) ──
UI-UX-UPGRADE-ACTION-PLAN.md

# IDEA 检查报告导出残留。导出请只用 XML；不要把 HTML 报告 add 到仓库
# 根或 debug/ 下。注意 debug/ 下的 XML 报告是有意跟踪的（需要留存查看），
# 不要放进这里。
/index.html
/debug/index.html

# Standalone native Android project generated state and machine-local SDK path
local.properties
.gradle/
**/build/
