location /api/v2/ {
    rewrite ^/api/v2/(.*) /api/$1 break;
    proxy_pass http://127.0.0.1:3037;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_hide_header Cache-Control;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "private, no-store" always;
}

location /assets/ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Access-Control-Allow-Origin "*" always;
    etag on;
    gzip_static on;
    try_files $uri =404;
}

# Static root assets (logo, favicon, robots, webmanifest)
location ~* ^/(?:favicon\.png|logo\.png|robots\.txt|site\.webmanifest)$ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
    add_header Access-Control-Allow-Origin "*" always;
    etag on;
    try_files $uri =404;
}

location / {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    # Content-Security-Policy for the SPA document. deploy.sh installs and
    # wires this automatically (install_spa_csp); the line is shown here so
    # the example matches a deployed config. Repeated per HTML location
    # because nginx add_header does not inherit into a location that
    # declares its own.
    include /etc/nginx/snippets/socrates-csp-spa.conf;
    try_files $uri /__APP_INDEX__;
}

location ~ ^/index\.[0-9]+\.html$ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    include /etc/nginx/snippets/socrates-csp-spa.conf;
}

# The CSP is applied by deploy.sh — no manual step is required:
#
#   1. scripts/gen-csp-hashes.mjs emits ops/nginx/csp-spa.conf from the same
#      directive map helmet uses in server/src/app.ts. `npm run lint` in
#      frontend/ fails if the two drift.
#   2. deploy.sh install_spa_csp copies it to
#      /etc/nginx/snippets/socrates-csp-spa.conf and inserts the `include`
#      into every HTML-serving location block via
#      ops/nginx/insert-csp-include.awk. Backup-first, `nginx -t`-validated,
#      restored on failure, idempotent per block.
#
# Verify after a deploy:
#   curl -sI https://app.topodrive.top/ | grep -i content-security-policy
#
# Override the install location with NGINX_SNIPPETS_DIR when testing.
