location /api/v2/ {
    rewrite ^/api/v2/(.*) /api/$1 break;
    proxy_pass http://127.0.0.1:3037;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_hide_header Cache-Control;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "private, no-store" always;
}

location /assets/ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Access-Control-Allow-Origin "*" always;
    etag on;
    gzip_static on;
    try_files $uri =404;
}

# Static root assets (logo, favicon, robots, webmanifest)
location ~* ^/(?:favicon\.png|logo\.png|robots\.txt|site\.webmanifest)$ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
    add_header Access-Control-Allow-Origin "*" always;
    etag on;
    try_files $uri =404;
}

location / {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    try_files $uri /__APP_INDEX__;
}

location ~ ^/index\.[0-9]+\.html$ {
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
}
