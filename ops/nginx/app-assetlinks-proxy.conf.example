# Include inside the app.topodrive.top HTTPS server block. This exact match must
# precede the SPA static/try_files fallback so the Express fail-closed endpoint
# owns the App Links document (do not publish a guessed certificate fingerprint).
location = /.well-known/assetlinks.json {
    proxy_pass http://127.0.0.1:3037/.well-known/assetlinks.json;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
