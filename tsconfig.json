{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@socrates/contracts": ["packages/contracts/src/index.ts"],
      "@socrates/core": ["packages/core/src/index.ts"],
      "@socrates/core/*": ["packages/core/src/*"],
      "@socrates/theme": ["packages/theme/src/index.ts"]
    }
  },
  "include": [
    "packages/contracts/src/**/*",
    "packages/core/src/**/*",
    "packages/theme/src/**/*"
  ],
  "exclude": [
    "packages/**/*.test.ts"
  ]
}
